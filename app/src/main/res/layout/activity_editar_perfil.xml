<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".EditarPerfilActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue_primary"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="30dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imgEditarPerfil"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:contentDescription="Foto de perfil"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_user" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar perfil"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATOS DEL PERFIL"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/gray_mid"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etEditarNombre"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Nombre"
                android:inputType="textPersonName"
                android:textColor="@color/blue_primary"
                android:textColorHint="@color/gray_mid"
                android:background="@drawable/input_borde"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <EditText
                android:id="@+id/etEditarApellidos"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:hint="Apellidos"
                android:inputType="textPersonName"
                android:textColor="@color/blue_primary"
                android:textColorHint="@color/gray_mid"
                android:background="@drawable/input_borde"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <EditText
                android:id="@+id/etEditarCorreo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:enabled="false"
                android:hint="Correo"
                android:inputType="textEmailAddress"
                android:textColor="@color/gray_mid"
                android:textColorHint="@color/gray_mid"
                android:background="@drawable/input_borde"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <EditText
                android:id="@+id/etEditarTelefono"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:hint="Telefono"
                android:inputType="phone"
                android:textColor="@color/blue_primary"
                android:textColorHint="@color/gray_mid"
                android:background="@drawable/input_borde"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <Button
                android:id="@+id/btnGuardarPerfil"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="Guardar cambios"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_iniciar"
                android:backgroundTint="@null" />

            <Button
                android:id="@+id/btnVolverPerfil"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Volver"
                android:textColor="@color/blue_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_crear"
                android:backgroundTint="@null" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
